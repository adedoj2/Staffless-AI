# Copy this file to .env and fill in your values. Never commit .env.

# Supabase Postgres connection string.
# Use the TRANSACTION POOLER string (port 6543) for the running app.
# Use the DIRECT string (port 5432) when applying schema.sql.
# Percent-encode special characters in the password (@ -> %40, etc.).
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:6543/postgres"

# Gemini (optional). Without a key the agent falls back to a keyword stub.
GEMINI_API_KEY=""
# Optional override; defaults to the gemini-1.5-flash generateContent endpoint.
# GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent"
